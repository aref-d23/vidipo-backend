# Application
NODE_ENV=production
PORT=3000
API_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
WEB_URL=http://localhost:3002
CORS_ORIGINS=

# PostgreSQL
POSTGRES_USER=app
POSTGRES_DB=myapp
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://app:CHANGE_ME@postgres:5432/myapp?schema=public

# Redis
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379

# JWT - replace with strong random secrets
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME

# Field encryption - replace with a securely generated key
FIELD_ENCRYPTION_KEY=CHANGE_ME

# MinIO / RustFS
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=myapp
MINIO_PUBLIC_URL=http://localhost:9000

RUSTFS_ACCESS_KEY=CHANGE_ME
RUSTFS_SECRET_KEY=CHANGE_ME

# SMS
SMS_PROVIDER=mock
KAVENEGAR_API_KEY=CHANGE_ME
KAVENEGAR_SENDER=CHANGE_ME

# Zarinpal payment gateway
ZARINPAL_MERCHANT_ID=CHANGE_ME
ZARINPAL_SANDBOX=true
